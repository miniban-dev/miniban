#MISE description="Check the UI embedded in the release server, using port 3102"

# Checks that the release miniban, started from outside the repository, serves its embedded HTML for the
# root and for a client-side route. Needs a prior mise run build:release.

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

start_server 3102
expect_html /
expect_html /board/1
